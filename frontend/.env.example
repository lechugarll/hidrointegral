# Copia este archivo a `.env` y ajusta los valores al desplegar.
# Solo valores PÚBLICOS: nunca pongas secretos ni claves aquí
# (las variables VITE_* se incluyen en el código que llega al navegador).

# Dominio para la analítica sin cookies (p. ej. Plausible). Vacío = sin analítica.
VITE_ANALYTICS_DOMAIN=
